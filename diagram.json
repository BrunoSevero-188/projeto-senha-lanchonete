{
  "version": 1,
  "author": "BrunoSevero-188",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": -400,
      "left": -200,
      "attrs": {}
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": -400,
      "left": 150,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-membrane-keypad",
      "id": "keypad1",
      "top": 50,
      "left": -300,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_verde",
      "top": -150,
      "left": 200,
      "rotate": 90,
      "attrs": { "color": "green", "flip": "1" }
    },
    {
      "type": "wokwi-led",
      "id": "led_vermelho",
      "top": -50,
      "left": 200,
      "rotate": 90,
      "attrs": { "color": "red", "flip": "1" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": -350,
      "left": -400,
      "attrs": { "volume": "0.3" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -250,
      "left": 100,
      "attrs": { "value": "4700" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": -200,
      "left": 100,
      "attrs": { "value": "4700" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "lcd1:SDA", "r1:2", "green", [ "h0" ] ],
    [ "r1:1", "esp:22", "green", [ "v0" ] ],
    [ "lcd1:SCL", "r2:2", "green", [ "h0" ] ],
    [ "r2:1", "esp:23", "green", [ "h0" ] ],
    [ "lcd1:VCC", "esp:3V3", "#8f4814", [ "v0" ] ],
    [ "lcd1:GND", "esp:GND.1", "red", [ "v0" ] ],
    [ "esp:13", "keypad1:R1", "green", [ "h0" ] ],
    [ "keypad1:R2", "esp:12", "green", [ "v0" ] ],
    [ "esp:14", "keypad1:R3", "green", [ "h0" ] ],
    [ "keypad1:R4", "esp:27", "green", [ "v0" ] ],
    [ "keypad1:C1", "esp:26", "green", [ "v0" ] ],
    [ "esp:25", "keypad1:C2", "green", [ "v0" ] ],
    [ "keypad1:C3", "esp:33", "green", [ "v0" ] ],
    [ "esp:32", "keypad1:C4", "green", [ "v0" ] ],
    [ "buzzer1:1", "esp:18", "blue", [ "v0" ] ],
    [ "esp:GND.2", "buzzer1:2", "red", [ "v0" ] ],
    [ "esp:19", "led_verde:A", "green", [ "h0" ] ],
    [ "esp:GND.3", "led_verde:C", "red", [ "v0" ] ],
    [ "esp:21", "led_vermelho:A", "green", [ "h0" ] ],
    [ "esp:GND.3", "led_vermelho:C", "red", [ "v0" ] ]
  ],
  "dependencies": {
    "LiquidCrystal_I2C": "",
    "Keypad": "",
    "ArduinoJson": "",
    "WebSockets": ""
  }
}